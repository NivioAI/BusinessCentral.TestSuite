{
  "name": "bc-flow-tester",
  "version": "0.1.0",
  "private": true,
  "author": "NIVIO BV",
  "description": "NIVIO Business Central test automation suite",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NivioAI/BusinessCentral.TestSuite.git"
  },
  "homepage": "https://github.com/NivioAI/BusinessCentral.TestSuite#readme",
  "bugs": {
    "url": "https://github.com/NivioAI/BusinessCentral.TestSuite/issues"
  },
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "postinstall": "bun node_modules/electron/install.js",
    "dev": "electron-vite dev",
    "build": "electron-vite build && bun run mcp:build",
    "mcp:build": "bun build src/mcp/server.ts --outdir out/mcp --target node",
    "mcp": "bun src/mcp/server.ts",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "runner:install": "bun install --cwd runner-runtime --production --frozen-lockfile",
    "package:mac": "bun run build && bun run runner:install && electron-builder --mac dmg zip",
    "package:win": "bun run build && bun run runner:install && electron-builder --win nsis"
  },
  "dependencies": {
    "@fontsource-variable/albert-sans": "^5.3.0",
    "@fontsource/libre-baskerville": "^5.3.0",
    "@microsoft/bc-replay": "0.1.139",
    "@modelcontextprotocol/sdk": "^1",
    "fflate": "0.8.2",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "yaml": "^2.6.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^3.0.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "44.9.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.0.0",
    "happy-dom": "^21.0.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  },
  "build": {
    "appId": "ai.nivio.bcflowtester",
    "productName": "NIVIO Test Suite",
    "npmRebuild": false,
    "icon": "build/icon.png",
    "afterPack": "scripts/ad-hoc-sign.cjs",
    "directories": {
      "output": "release"
    },
    "files": ["out/**/*", "package.json"],
    "extraResources": [
      {
        "from": "runner-runtime",
        "to": "runner",
        "filter": [
          "package.json",
          "bun.lock",
          "Replay.mac.ps1",
          "manual-mfa.spec.cjs",
          "manual-mfa.config.cjs",
          "node_modules/**/*"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": ["dmg", "zip"]
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "trustedDependencies": ["electron"]
}
